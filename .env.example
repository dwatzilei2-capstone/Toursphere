# Toursphere Fleet & Transportation Management
# Copy to .env, then replace the placeholders. Never commit .env.

# Local PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=fleetcore
DB_USER=postgres
DB_PASS=12345
DB_SSLMODE=prefer

# Supabase: copy Host, Port, Database, User, and Password from
# Project Settings > Database. Use DB_SSLMODE=require.

GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
AI_API_KEY=YOUR_SERVER_SIDE_AI_KEY
APP_ENV=development
APP_DEBUG=true

# Password recovery: SYSTEM mailbox only. Never use a recovering user's credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=
# Recovery email always uses the application's configured company name.
SMTP_FROM_NAME=

# Full Google-routable depot address used by Driver Return-to-Depot navigation.
# If omitted, the official trip origin is used as the safe return point.
FLEET_DEPOT_ADDRESS=YOUR_FULL_DEPOT_ADDRESS
