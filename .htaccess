 
 
 

 
<FilesMatch "^(\.env|\.git|\.gitignore|composer\.(json|lock)|package\.json|.*\.sql|.*\.log|.*\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

 
Options -Indexes

# Composer dependencies and internal recovery tooling are never public resources.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:vendor|tmp|lib/reporting)/ - [F,L]
</IfModule>

 
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>
